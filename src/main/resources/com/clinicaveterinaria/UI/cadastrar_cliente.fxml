            fx:controller="com.clinicaveterinaria.UI.CadastrarClienteController">
   <HBox prefHeight="56.0" prefWidth="900.0" spacing="620.0">
      <padding>
         <Insets left="10.0" top="10.0"/>
      </padding>
      <Label text="Cadastrar Cliente">
         <font>
            <Font name="Arial Black" size="20.0"/>
         </font>
         <HBox.margin>
            <Insets left="10.0"/>
         </HBox.margin>
      </Label>
      <Button fx:id="voltarButton" mnemonicParsing="false" onAction="#voltarCliente" prefHeight="28.0" prefWidth="52.0"
              style="-fx-background-color: #000000;" text="voltar" textFill="WHITE">
         <HBox.margin>
            <Insets right="10.0"/>
         </HBox.margin>
         <font>
            <Font name="System Bold" size="12.0"/>
         </font>
      </Button>
   </HBox>
   <VBox alignment="CENTER_LEFT" layoutX="324.0" layoutY="140.0" prefHeight="252.0" prefWidth="273.0" spacing="5.0">
      <Label text="NOME COMPLETO:"/>
      <TextField prefHeight="25.0" prefWidth="205.0" promptText="Nome Completo"/>
      <Label text="TELEFONE:"/>
      <TextField prefHeight="25.0" prefWidth="215.0" promptText="(00) 0000-0000"/>
      <Label text="CPF:"/>
      <TextField prefHeight="25.0" prefWidth="215.0" promptText="000.000.000-00"/>
      <Label text="EMAIL:"/>
      <TextField prefHeight="25.0" prefWidth="215.0" promptText="Email"/>
      <Label text="ENDEREÇO:"/>
      <TextField prefHeight="25.0" prefWidth="215.0" promptText="Endereço"/>
      <Label prefWidth="29.0" text="PETS:"/>
      <ListView prefHeight="200.0" prefWidth="200.0"/>
      <HBox alignment="CENTER" prefHeight="47.0" prefWidth="900.0" spacing="20.0">
         <Button mnemonicParsing="false" fx:id="addButton" onAction="#cadastrarAnimal" style="-fx-background-color: #000000;" text="Adicionar" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0"/>
            </font>
         </Button>
         <Button mnemonicParsing="false" style="-fx-background-color: #000000;" text="Remover" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0"/>
            </font>
         </Button>
      </HBox>
   </VBox>
   <HBox alignment="CENTER" layoutX="5.0" layoutY="500.0" prefHeight="100.0" prefWidth="914.0">
      <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="74.0" style="-fx-background-color: #000000;"
              text="Cadastrar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0"/>
         </font>
      </Button>
   </HBox>
